<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#FFFFFF">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#151B2C" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
    <ImageView android:id="@+id/widget_qr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/widget_saved_qr" android:scaleType="fitCenter" />
</LinearLayout>
